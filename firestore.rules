rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/prayerGroups/$(groupId);
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/prayerGroups/$(groupId)/members/$(uid);
    }

    function invitationPath(scheduleId, uid) {
      return /databases/$(database)/documents/prayerSchedules/$(scheduleId)/invitations/$(uid);
    }

    function isGroupMember(groupId) {
      return signedIn() && exists(memberPath(groupId, request.auth.uid));
    }

    function isGroupAdmin(groupId) {
      return isGroupMember(groupId)
        && get(memberPath(groupId, request.auth.uid)).data.role == 'admin';
    }

    function postPath(collectionName, postId) {
      return /databases/$(database)/documents/$(collectionName)/$(postId);
    }

    function identityPath(collectionName, postId) {
      return /databases/$(database)/documents/$(collectionName)/$(postId)/moderation/identity;
    }

    function isPostOwner(collectionName, postId, post) {
      return signedIn()
        && (post.get('authorUid', '') == request.auth.uid
          || (exists(identityPath(collectionName, postId))
            && get(identityPath(collectionName, postId)).data.uid == request.auth.uid));
    }

    function canReadPost(collectionName, postId, post) {
      return signedIn()
        && post.status == 'active'
        && (post.audience == 'public'
          || isPostOwner(collectionName, postId, post)
          || (post.audience == 'group' && isGroupMember(post.groupId)));
    }

    function validProfile(data, uid) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'bio',
          'phoneNumber',
          'notificationPreferences',
          'privacyPreferences',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.email is string
        && data.email == request.auth.token.email
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && (!('notificationPreferences' in data)
          || (data.notificationPreferences is map
            && data.notificationPreferences.keys().hasOnly([
              'groupActivity',
              'scheduleReminders',
              'prayerEncouragement'
            ])
            && (!('groupActivity' in data.notificationPreferences)
              || data.notificationPreferences.groupActivity is bool)
            && (!('scheduleReminders' in data.notificationPreferences)
              || data.notificationPreferences.scheduleReminders is bool)
            && (!('prayerEncouragement' in data.notificationPreferences)
              || data.notificationPreferences.prayerEncouragement is bool)))
        && (!('privacyPreferences' in data)
          || (data.privacyPreferences is map
            && data.privacyPreferences.keys().hasOnly(['defaultPostAudience'])
            && (!('defaultPostAudience' in data.privacyPreferences)
              || data.privacyPreferences.defaultPostAudience in ['public', 'private'])));
    }

    function validGroup(data) {
      return data.keys().hasOnly([
          'name',
          'description',
          'creatorUid',
          'creatorName',
          'visibility',
          'memberCount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'name',
          'description',
          'creatorUid',
          'creatorName',
          'visibility',
          'memberCount',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.description is string
        && data.description.size() >= 12
        && data.description.size() <= 500
        && data.creatorUid is string
        && data.creatorName is string
        && data.creatorName.size() <= 80
        && data.visibility == 'public'
        && data.memberCount is int
        && data.memberCount >= 1
        && data.updatedAt == request.time;
    }

    function validPost(data, postType) {
      return data.keys().hasOnly([
          'type',
          'text',
          'audience',
          'groupId',
          'status',
          'createdAt',
          'updatedAt',
          'authorUid',
          'authorName',
          'authorPhotoURL',
          'anonymous'
        ])
        && data.keys().hasAll([
          'type',
          'text',
          'audience',
          'groupId',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.type == postType
        && data.text is string
        && data.text.size() >= 4
        && data.text.size() <= 3000
        && data.audience in ['public', 'group', 'private']
        && data.status == 'active'
        && data.updatedAt == request.time
        && data.createdAt == request.time
        && ((data.audience == 'group'
            && data.groupId is string
            && isGroupMember(data.groupId))
          || (data.audience != 'group' && data.groupId == null))
        && ((data.get('anonymous', false) == true
            && postType == 'prayerRequests'
            && !('authorUid' in data)
            && !('authorName' in data)
            && !('authorPhotoURL' in data))
          || (data.get('anonymous', false) == false
            && data.authorUid == request.auth.uid
            && data.authorName is string
            && data.authorName.size() > 0
            && data.authorName.size() <= 80
            && (data.authorPhotoURL == null
              || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048))));
    }

    match /users/{uid} {
      allow get: if isUser(uid);
      allow list: if false;
      allow create: if isUser(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isUser(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /prayerGroups/{groupId} {
      allow get, list: if signedIn() && resource.data.visibility == 'public';
      allow create: if signedIn()
        && validGroup(request.resource.data)
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && getAfter(memberPath(groupId, request.auth.uid)).data.role == 'admin';
      allow update: if signedIn()
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'description',
          'memberCount',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && ((isGroupAdmin(groupId)
            && request.resource.data.memberCount == resource.data.memberCount
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name',
              'description',
              'updatedAt'
            ]))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'memberCount',
                'updatedAt'
              ])
            && ((request.resource.data.memberCount == resource.data.memberCount + 1
                && getAfter(memberPath(groupId, request.auth.uid)).data.uid == request.auth.uid)
              || (request.resource.data.memberCount == resource.data.memberCount - 1
                && ((exists(memberPath(groupId, request.auth.uid))
                    && get(memberPath(groupId, request.auth.uid)).data.role == 'member'
                    && !existsAfter(memberPath(groupId, request.auth.uid)))
                  || (isGroupAdmin(groupId)
                    && resource.data.memberCount > 1))))));
      allow delete: if false;

      match /members/{uid} {
        allow get: if isUser(uid) || isGroupMember(groupId);
        allow list: if isUser(uid) || isGroupMember(groupId);
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'groupName', 'role', 'joinedAt'])
          && request.resource.data.keys().hasAll(['uid', 'displayName', 'groupName', 'role', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.groupName is string
          && request.resource.data.groupName.size() <= 80
          && request.resource.data.joinedAt == request.time
          && ((request.resource.data.role == 'admin'
              && getAfter(groupPath(groupId)).data.creatorUid == uid
              && getAfter(groupPath(groupId)).data.memberCount == 1)
            || (request.resource.data.role == 'member'
              && get(groupPath(groupId)).data.visibility == 'public'
              && getAfter(groupPath(groupId)).data.memberCount == get(groupPath(groupId)).data.memberCount + 1));
        allow update: if false;
        allow delete: if signedIn()
          && resource.data.role == 'member'
          && (uid == request.auth.uid || isGroupAdmin(groupId))
          && getAfter(groupPath(groupId)).data.memberCount == get(groupPath(groupId)).data.memberCount - 1;
      }

      match /messages/{messageId} {
        allow get, list: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly(['uid', 'authorName', 'photoURL', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['uid', 'authorName', 'photoURL', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 80
          && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isGroupMember(groupId)
          && (resource.data.uid == request.auth.uid || isGroupAdmin(groupId));
      }
    }

    match /{path=**}/members/{uid} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /prayerSchedules/{scheduleId} {
      allow get, list: if signedIn()
        && (resource.data.creatorUid == request.auth.uid
          || (resource.data.groupId is string && isGroupMember(resource.data.groupId))
          || exists(invitationPath(scheduleId, request.auth.uid)));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title',
          'description',
          'startsAt',
          'durationMinutes',
          'timeZone',
          'groupId',
          'recurrence',
          'updatedAt',
          'creatorUid',
          'cancelled',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'title',
          'description',
          'startsAt',
          'durationMinutes',
          'timeZone',
          'groupId',
          'recurrence',
          'updatedAt',
          'creatorUid',
          'cancelled',
          'createdAt'
        ])
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.startsAt is timestamp
        && request.resource.data.startsAt > request.time
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 15
        && request.resource.data.durationMinutes <= 240
        && request.resource.data.timeZone is string
        && request.resource.data.timeZone.size() <= 64
        && (request.resource.data.recurrence == null
          || (request.resource.data.recurrence is map
            && request.resource.data.recurrence.keys().hasOnly(['frequency', 'interval', 'count'])
            && request.resource.data.recurrence.keys().hasAll(['frequency', 'interval', 'count'])
            && request.resource.data.recurrence.frequency in ['daily', 'weekly', 'monthly']
            && request.resource.data.recurrence.interval == 1
            && request.resource.data.recurrence.count is int
            && request.resource.data.recurrence.count >= 2
            && request.resource.data.recurrence.count <= 52))
        && (request.resource.data.groupId == null
          || (request.resource.data.groupId is string && isGroupMember(request.resource.data.groupId)))
        && request.resource.data.cancelled == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.creatorUid == request.auth.uid
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'startsAt',
          'durationMinutes',
          'timeZone',
          'recurrence',
          'cancelled',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.startsAt is timestamp
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 15
        && request.resource.data.durationMinutes <= 240
        && request.resource.data.timeZone is string
        && request.resource.data.timeZone.size() <= 64
        && (request.resource.data.recurrence == null
          || (request.resource.data.recurrence is map
            && request.resource.data.recurrence.keys().hasOnly(['frequency', 'interval', 'count'])
            && request.resource.data.recurrence.keys().hasAll(['frequency', 'interval', 'count'])
            && request.resource.data.recurrence.frequency in ['daily', 'weekly', 'monthly']
            && request.resource.data.recurrence.interval == 1
            && request.resource.data.recurrence.count is int
            && request.resource.data.recurrence.count >= 2
            && request.resource.data.recurrence.count <= 52))
        && request.resource.data.cancelled is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /attendance/{uid} {
        allow get, list: if isUser(uid)
          || (signedIn()
            && get(/databases/$(database)/documents/prayerSchedules/$(scheduleId)).data.creatorUid == request.auth.uid);
        allow create, update: if isUser(uid)
          && request.resource.data.keys().hasOnly(['uid', 'status', 'updatedAt'])
          && request.resource.data.keys().hasAll(['uid', 'status', 'updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.status in ['attending', 'declined']
          && request.resource.data.updatedAt == request.time
          && ((get(/databases/$(database)/documents/prayerSchedules/$(scheduleId)).data.groupId is string
              && isGroupMember(get(/databases/$(database)/documents/prayerSchedules/$(scheduleId)).data.groupId))
            || (exists(invitationPath(scheduleId, uid))
              && get(invitationPath(scheduleId, uid)).data.status == 'accepted'));
        allow delete: if isUser(uid);
      }

      match /invitations/{uid} {
        allow get: if signedIn()
          && (isUser(uid)
            || get(/databases/$(database)/documents/prayerSchedules/$(scheduleId)).data.creatorUid == request.auth.uid);
        allow list: if signedIn() && isUser(uid) && resource.data.uid == request.auth.uid;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'uid',
            'sourceGroupId',
            'invitedBy',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'uid',
            'sourceGroupId',
            'invitedBy',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.sourceGroupId is string
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && isGroupMember(request.resource.data.sourceGroupId)
          && exists(memberPath(request.resource.data.sourceGroupId, uid))
          && getAfter(/databases/$(database)/documents/prayerSchedules/$(scheduleId)).data.creatorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/prayerSchedules/$(scheduleId)).data.groupId == null;
        allow update: if isUser(uid)
          && resource.data.uid == uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn()
          && (isUser(uid)
            || get(/databases/$(database)/documents/prayerSchedules/$(scheduleId)).data.creatorUid == request.auth.uid);
      }
    }

    match /{path=**}/invitations/{uid} {
      allow get: if isUser(uid) && resource.data.uid == request.auth.uid;
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /prayerRequests/{postId} {
      allow get, list: if canReadPost('prayerRequests', postId, resource.data);
      allow create: if signedIn() && validPost(request.resource.data, 'prayerRequests')
        && (request.resource.data.get('anonymous', false) == false
          || getAfter(identityPath('prayerRequests', postId)).data.uid == request.auth.uid);
      allow update: if isPostOwner('prayerRequests', postId, resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['active', 'deleted']
        && ((request.resource.data.status == 'active'
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 4
            && request.resource.data.text.size() <= 3000)
          || (request.resource.data.status == 'deleted' && request.resource.data.text == ''));
      allow delete: if false;

      match /moderation/{identityId} {
        allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
        allow create: if signedIn()
          && identityId == 'identity'
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(postPath('prayerRequests', postId)).data.anonymous == true;
        allow update: if false;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      match /prayingUsers/{uid} {
        allow get: if isUser(uid) && canReadPost('prayerRequests', postId, get(postPath('prayerRequests', postId)).data);
        allow list: if false;
        allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time
          && canReadPost('prayerRequests', postId, get(postPath('prayerRequests', postId)).data);
        allow delete: if isUser(uid)
          && canReadPost('prayerRequests', postId, get(postPath('prayerRequests', postId)).data);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow get, list: if canReadPost('prayerRequests', postId, get(postPath('prayerRequests', postId)).data);
        allow create: if signedIn()
          && canReadPost('prayerRequests', postId, get(postPath('prayerRequests', postId)).data)
          && request.resource.data.keys().hasOnly(['uid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /testimonies/{postId} {
      allow get, list: if canReadPost('testimonies', postId, resource.data);
      allow create: if signedIn() && validPost(request.resource.data, 'testimonies')
        && request.resource.data.get('anonymous', false) == false;
      allow update: if isPostOwner('testimonies', postId, resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['active', 'deleted']
        && ((request.resource.data.status == 'active'
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 4
            && request.resource.data.text.size() <= 3000)
          || (request.resource.data.status == 'deleted' && request.resource.data.text == ''));
      allow delete: if false;

      match /reactions/{uid} {
        allow get: if isUser(uid) && canReadPost('testimonies', postId, get(postPath('testimonies', postId)).data);
        allow list: if false;
        allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['uid', 'emoji', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.emoji == 'heart'
          && request.resource.data.createdAt == request.time
          && canReadPost('testimonies', postId, get(postPath('testimonies', postId)).data);
        allow delete: if isUser(uid)
          && canReadPost('testimonies', postId, get(postPath('testimonies', postId)).data);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow get, list: if canReadPost('testimonies', postId, get(postPath('testimonies', postId)).data);
        allow create: if signedIn()
          && canReadPost('testimonies', postId, get(postPath('testimonies', postId)).data)
          && request.resource.data.keys().hasOnly(['uid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow get: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'contentType', 'contentId', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.contentType in ['prayerRequests', 'testimonies']
        && request.resource.data.contentId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && (request.resource.data.readAt == null || request.resource.data.readAt == request.time);
    }

    match /deviceTokens/{tokenId} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'token', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'token', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 40
        && request.resource.data.token.size() <= 4096
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /callSessions/{callId} {
      allow get: if signedIn()
        && resource.data.participantUids is list
        && request.auth.uid in resource.data.participantUids;
      allow list: if signedIn()
        && (resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantUids',
          'callerUid',
          'callerName',
          'calleeUid',
          'calleeName',
          'groupId',
          'callType',
          'status',
          'offer',
          'answer',
          'createdAt',
          'updatedAt',
          'endedAt'
        ])
        && request.resource.data.keys().hasAll([
          'participantUids',
          'callerUid',
          'callerName',
          'calleeUid',
          'calleeName',
          'groupId',
          'callType',
          'status',
          'offer',
          'answer',
          'createdAt',
          'updatedAt',
          'endedAt'
        ])
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid == request.resource.data.callerUid
        && request.resource.data.participantUids.hasAll([
          request.resource.data.callerUid,
          request.resource.data.calleeUid
        ])
        && request.resource.data.callerUid != request.resource.data.calleeUid
        && request.resource.data.callerName is string
        && request.resource.data.callerName.size() <= 80
        && request.resource.data.calleeName is string
        && request.resource.data.calleeName.size() <= 80
        && request.resource.data.groupId is string
        && isGroupMember(request.resource.data.groupId)
        && exists(memberPath(request.resource.data.groupId, request.resource.data.calleeUid))
        && request.resource.data.callType in ['audio', 'video']
        && request.resource.data.status == 'ringing'
        && request.resource.data.offer is map
        && request.resource.data.offer.keys().hasOnly(['type', 'sdp'])
        && request.resource.data.offer.type == 'offer'
        && request.resource.data.offer.sdp is string
        && request.resource.data.offer.sdp.size() <= 100000
        && request.resource.data.answer == null
        && request.resource.data.endedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.participantUids is list
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'offer',
          'answer',
          'updatedAt',
          'endedAt'
        ])
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.updatedAt == request.time
        && ((request.auth.uid == resource.data.calleeUid
            && resource.data.status == 'ringing'
            && request.resource.data.status == 'active'
            && request.resource.data.offer == resource.data.offer
            && request.resource.data.answer is map
            && request.resource.data.answer.keys().hasOnly(['type', 'sdp'])
            && request.resource.data.answer.type == 'answer'
            && request.resource.data.answer.sdp is string
            && request.resource.data.answer.sdp.size() <= 100000
            && request.resource.data.endedAt == null)
          || (request.auth.uid == resource.data.calleeUid
            && resource.data.status == 'ringing'
            && request.resource.data.status == 'declined'
            && request.resource.data.offer == null
            && request.resource.data.answer == null
            && request.resource.data.endedAt == request.time)
          || (resource.data.status in ['ringing', 'active']
            && request.resource.data.status == 'ended'
            && request.resource.data.offer == null
            && request.resource.data.answer == null
            && request.resource.data.endedAt == request.time));
      allow delete: if signedIn()
        && resource.data.participantUids is list
        && request.auth.uid in resource.data.participantUids
        && resource.data.status in ['ended', 'declined'];

      match /signals/{signalId} {
        function isCallParticipant() {
          return signedIn()
            && get(/databases/$(database)/documents/callSessions/$(callId)).data.participantUids
              .hasAny([request.auth.uid]);
        }

        allow get, list: if isCallParticipant();
        allow create: if isCallParticipant()
          && get(/databases/$(database)/documents/callSessions/$(callId)).data.status
            in ['ringing', 'active']
          && request.resource.data.keys().hasOnly(['senderUid', 'candidate', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderUid', 'candidate', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.candidate is map
          && request.resource.data.candidate.candidate is string
          && request.resource.data.candidate.candidate.size() <= 4096
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isCallParticipant();
      }

      match /participants/{uid} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
